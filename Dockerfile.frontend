# ──────────────────────────────────────────────
# Stage 1 – Build Angular with Node 18
# ──────────────────────────────────────────────
FROM node:18-alpine AS build
WORKDIR /app

# Cache npm dependencies
COPY frontend/package*.json ./
RUN npm ci --quiet

# Copy source and build (browser-only, no SSR prerender)
COPY frontend/ .
RUN npx ng build --configuration=production --prerender=false

# ──────────────────────────────────────────────
# Stage 2 – Serve with nginx (HTTP + HTTPS)
# ──────────────────────────────────────────────
FROM nginx:1.27-alpine
WORKDIR /usr/share/nginx/html

# Install openssl for self-signed cert generation
RUN apk add --no-cache openssl

# Remove default nginx content
RUN rm -rf ./*

# Copy compiled Angular browser bundle
COPY --from=build /app/dist/stock-brokerage-ui/browser ./

# Copy custom nginx config
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Copy custom entrypoint (generates self-signed cert if none present)
COPY docker-entrypoint-frontend.sh /docker-entrypoint-frontend.sh
RUN chmod +x /docker-entrypoint-frontend.sh

EXPOSE 80 443

ENTRYPOINT ["/docker-entrypoint-frontend.sh"]


CMD ["nginx", "-g", "daemon off;"]
